{
  "LambdaFunctionConfigurations": [
    {
      "Id": "image-thumbnail-jpg",
      "LambdaFunctionArn": "arn:aws:lambda:us-west-2:221025630675:function:image-thumbnails-dev-generateThumbnail",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            {"Name": "prefix", "Value": "public/projects/"},
            {"Name": "suffix", "Value": ".jpg"}
          ]
        }
      }
